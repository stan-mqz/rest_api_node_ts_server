{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "lib": ["ESNext", "DOM"],
        "strict": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "declaration": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,    
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node10",
    },

    "include": ["src/**/*.ts"]
}